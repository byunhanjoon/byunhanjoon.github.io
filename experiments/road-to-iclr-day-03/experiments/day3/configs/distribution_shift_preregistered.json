{
  "version": "1.0-frozen-before-random-split-outcomes",
  "purpose": "Compare controlled-basis sensitivity under the official chronological split and a fixed row-random 70/15/15 resplit of the same temporal finance tables.",
  "datasets": {
    "compustat_kor_direction_random": {
      "source_name": "compustat_kor_direction",
      "path": "/data/tokenization_icaif_grouped_v2/compustat_kor_direction"
    },
    "kdd17_stock_direction_random": {
      "source_name": "kdd17_stock_direction",
      "path": "/data/tokenization_icaif_grouped_v2/kdd17_stock_direction"
    },
    "kdd17_stock_return_random": {
      "source_name": "kdd17_stock_return",
      "path": "/data/tokenization_icaif_grouped_v2/kdd17_stock_return"
    }
  },
  "resplit": {
    "kind": "row_random",
    "seed": 20260825,
    "train_fraction": 0.70,
    "validation_fraction": 0.15,
    "test_fraction": 0.15,
    "max_train_rows": 50000,
    "max_eval_rows": 20000,
    "subsample_seed": 2026
  },
  "representation": "controlled",
  "kappas": [1.0, 1000.0],
  "models": ["mlp"],
  "remedy": "adamw",
  "seeds": [0, 1, 2],
  "learning_rate_source": "Frozen AdamW calibration from selected_hyperparameters.json",
  "interpretation_limit": "The row-random split is an explicit easier-distribution comparator and may mix entities or adjacent dates; it is not a deployment recommendation."
}
