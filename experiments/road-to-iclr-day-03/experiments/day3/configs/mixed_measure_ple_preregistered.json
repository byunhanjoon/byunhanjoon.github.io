{
  "version": "1.0-frozen-before-outcomes",
  "frozen_at": "2026-08-25T23:05:00+09:00",
  "hypothesis": "Quantile PLE wastes resolution on point masses. A fixed-width direct-sum encoding of empirical atoms and a conditional continuous spline will recover Adult-like rare-state performance and transfer to mixed-measure tabular columns.",
  "representations": [
    "baseline_fixed_ple",
    "tail_reallocated_ple",
    "mixed_measure_ple"
  ],
  "datasets": [
    "adult",
    "black-friday",
    "california",
    "churn",
    "diamond",
    "higgs-small",
    "house",
    "microsoft"
  ],
  "models": ["mlp", "resnet", "tabm"],
  "seeds": [0, 1, 2],
  "encoding": {
    "coordinate_budget_per_numeric_column": 128,
    "atom_minimum_mass": "1 / coordinate_budget",
    "maximum_atoms_per_column": 16,
    "minimum_nonatom_rows": 32,
    "atom_selection_uses_targets": false,
    "unknown_atom_fallback": "conditional_continuous_component"
  },
  "data": {
    "max_train_rows": 100000,
    "max_eval_rows": 25000,
    "sample_seed": 2026
  },
  "training": {
    "ensemble_size": 8,
    "max_epochs": 40,
    "patience": 6
  },
  "primary_comparison": "mixed_measure_ple minus baseline_fixed_ple",
  "primary_endpoint": "dataset-mean relative proper-loss reduction, with positive meaning better",
  "claim_gate": {
    "minimum_mean_relative_proper_loss_reduction": 0.005,
    "minimum_dataset_win_fraction": 0.6,
    "require_positive_dataset_bootstrap_lower_bound": true,
    "require_positive_mean_official_score_change": true,
    "adult_minimum_accuracy_gain_percentage_points": 0.5,
    "adult_require_all_backbone_means_positive": true,
    "bootstrap_samples": 10000,
    "confidence": 0.95
  },
  "stop_rule": "If the gate fails, do not promote mixed-measure PLE; diagnose which component failed and formulate the next hypothesis before further outcomes are inspected."
}
